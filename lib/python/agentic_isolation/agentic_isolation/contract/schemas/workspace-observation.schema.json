{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standards.agentparadise.dev/experimental/v1/workspace/workspace-observation.schema.json",
  "title": "APSS Workspace Observation Page",
  "description": "One bounded page of an operation's output stream, addressed by opaque cursors.",
  "$ref": "#/$defs/observationPage",
  "required": [
    "schema"
  ],
  "$defs": {
    "observationPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "state",
        "cursor",
        "next_cursor",
        "data_b64",
        "complete"
      ],
      "properties": {
        "schema": {
          "const": "apss.workspace-observation/v1"
        },
        "ref": {
          "$ref": "workspace-operation.schema.json#/$defs/operationRef"
        },
        "state": {
          "$ref": "workspace-status.schema.json#/$defs/state"
        },
        "cursor": {
          "type": "string",
          "minLength": 1
        },
        "next_cursor": {
          "type": "string",
          "minLength": 1
        },
        "data_b64": {
          "type": "string",
          "contentEncoding": "base64",
          "pattern": "^([A-Za-z0-9+/]{4})*([A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "gap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lost_bytes"
          ],
          "properties": {
            "lost_bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          }
        },
        "loss_detected": {
          "description": "Since 0.2.1. True when this generation lost bytes to retention before next_cursor, on this page or an earlier one of the same drain. Required on the completing page of a drain that lost bytes; absent means no loss is claimed.",
          "const": true
        },
        "complete": {
          "type": "boolean"
        }
      },
      "if": {
        "properties": {
          "complete": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "state": {
            "$ref": "workspace-status.schema.json#/$defs/terminalState"
          }
        }
      }
    }
  }
}
