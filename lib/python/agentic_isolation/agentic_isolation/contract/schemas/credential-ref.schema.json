{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standards.agentparadise.dev/experimental/v1/workspace/credential-ref.schema.json",
  "title": "APSS Credential Reference",
  "description": "Names a credential the provider resolves from implementation-owned configuration. Never carries a value.",
  "$ref": "#/$defs/credentialRef",
  "required": [
    "schema"
  ],
  "$defs": {
    "credentialRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "scope"
      ],
      "properties": {
        "schema": {
          "const": "apss.credential-ref/v1"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "credentialBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "delivery",
        "target"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/credentialRef"
        },
        "delivery": {
          "enum": [
            "env",
            "file"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "credentialFreeStringMap": {
      "description": "A free-form string map. Keys naming a credential value are rejected; a secret under an innocuous key cannot be recognized by a schema, so spec 5.1.3 forbids it normatively.",
      "type": "object",
      "propertyNames": {
        "not": {
          "pattern": "^[Vv][Aa][Ll][Uu][Ee]$|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Aa][Ss][Ss]([Ww][Oo][Rr][Dd]|[Ww][Dd])|[Aa][Pp][Ii]_?[Kk][Ee][Yy]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee]_?[Kk][Ee][Yy]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]"
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
