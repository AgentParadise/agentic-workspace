{
  "schema": "apss.workspace-provider/v1",
  "provider": "docker",
  "security_profile": "isolated",
  "enforceable_limits": {
    "cpu": true,
    "memory": true,
    "disk": false,
    "network": true,
    "timeout": true
  },
  "capabilities": [
    "git",
    "python3"
  ],
  "observation": {
    "retention_bytes": 8388608,
    "max_page_bytes": 65536,
    "integrity": "exact"
  },
  "interactive": false,
  "environment_kinds": [
    "oci-image"
  ]
}
