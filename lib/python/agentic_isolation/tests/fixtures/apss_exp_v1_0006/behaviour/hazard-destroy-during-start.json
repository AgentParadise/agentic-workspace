            "schema": "apss.workspace-status/v1",
            "kind": "resource_lost",
            "message": "workspace ws-7f3a destroyed while resolving credential github-app"
          }
        },
        {
          "schema": "workspace-status.schema.json",
          "document": {
            "schema": "apss.workspace-status/v1",
            "kind": "cancelled",
            "message": "start abandoned: workspace ws-7f3a destroyed"
          }
        }
      ],
      "launches": 0,
      "operation_records": 0
    },
    {
      "call": "start",
      "args": {
        "spec": {
