{
  "description": "The workload double-forks a descendant that setsid-detaches and is reparented before cancel. cancel either kills it and reports a confirmed cancelled, or reports the unconfirmed outcome (kind timeout with the ref) while it lives; it never reports cancelled while the descendant is alive.",
  "hazard": "LH-1",
  "steps": [
    {
      "call": "start",
      "args": {
        "spec": {
          "schema": "apss.workspace-operation/v1",
          "execution_id": "exec-42",
          "operation_key": "exec-42:phase-1:fence-9:agent",
          "argv": [
            "agent",
            "--print",
            "--output-format",
            "stream-json"
          ],
          "working_directory": "repo",
          "environment": {
            "LANG": "C.UTF-8"
          },
          "credential_bindings": [
            {
              "ref": {
                "name": "github-app",
                "scope": "repo:acme/widgets"
              },
              "delivery": "env",
              "target": "GH_TOKEN"
            }
          ],
          "launch_marker": {
            "argv0": "agent-launch",
            "line": "APSS-LAUNCH 6f1e9c"
          },
          "timeout_seconds": 3600,
          "metadata": {
            "phase_id": "phase-1"
          }
        }
      },
      "expect": {
        "schema": "workspace-operation.schema.json#/$defs/operationRef",
        "document": {
          "workspace": {
            "provider": "docker",
            "resource_id": "ws-7f3a"
          },
          "operation_id": "op-0001",
          "operation_key": "exec-42:phase-1:fence-9:agent"
        }
      },
      "launches": 1
    },
    {
      "call": "cancel",
      "args": {
        "ref": {
          "workspace": {
            "provider": "docker",
            "resource_id": "ws-7f3a"
          },
          "operation_id": "op-0001",
          "operation_key": "exec-42:phase-1:fence-9:agent"
        }
      },
      "given": [
        "detached_descendant"
      ],
      "settles_within_seconds": 60,
      "expect_one_of": [
        {
          "schema": "workspace-status.schema.json",
          "document": {
            "schema": "apss.workspace-status/v1",
            "ref": {
              "workspace": {
                "provider": "docker",
                "resource_id": "ws-7f3a"
              },
              "operation_id": "op-0001",
              "operation_key": "exec-42:phase-1:fence-9:agent"
            },
            "state": "cancelled",
            "execution_id": "exec-42",
            "metadata": {},
            "exit_code": null,
            "signal": "SIGKILL"
          },
          "descendant_alive": false
        },
        {
          "schema": "workspace-status.schema.json",
          "document": {
            "schema": "apss.workspace-status/v1",
            "kind": "timeout",
            "message": "cancel escalated: detached descendant pid 4242 still alive after SIGKILL",
            "ref": {
              "workspace": {
                "provider": "docker",
                "resource_id": "ws-7f3a"
              },
              "operation_id": "op-0001",
              "operation_key": "exec-42:phase-1:fence-9:agent"
            }
          },
          "descendant_alive": true
        }
      ],
      "launches": 1
    },
    {
      "call": "status",
      "args": {
        "ref": {
          "workspace": {
            "provider": "docker",
            "resource_id": "ws-7f3a"
          },
          "operation_id": "op-0001",
          "operation_key": "exec-42:phase-1:fence-9:agent"
        }
      },
      "given": [
        "detached_descendant"
      ],
      "settles_within_seconds": 10,
      "expect_one_of": [
        {
          "schema": "workspace-status.schema.json",
          "document": {
            "schema": "apss.workspace-status/v1",
            "ref": {
              "workspace": {
                "provider": "docker",
                "resource_id": "ws-7f3a"
              },
              "operation_id": "op-0001",
              "operation_key": "exec-42:phase-1:fence-9:agent"
            },
            "state": "cancelled",
            "execution_id": "exec-42",
            "metadata": {},
            "exit_code": null,
            "signal": "SIGKILL"
          },
          "descendant_alive": false
        },
        {
          "schema": "workspace-status.schema.json",
          "document": {
            "schema": "apss.workspace-status/v1",
            "ref": {
              "workspace": {
                "provider": "docker",
                "resource_id": "ws-7f3a"
              },
              "operation_id": "op-0001",
              "operation_key": "exec-42:phase-1:fence-9:agent"
            },
            "state": "running",
            "execution_id": "exec-42",
            "metadata": {}
          },
          "descendant_alive": true
        }
      ],
      "launches": 1
    }
  ]
}
