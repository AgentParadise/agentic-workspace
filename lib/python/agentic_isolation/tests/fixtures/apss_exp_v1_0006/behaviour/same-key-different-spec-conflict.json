{
  "description": "Reusing an operation_key with a different spec is a conflict and launches nothing new.",
  "steps": [
    {
      "call": "start",
      "args": {
        "spec": {
          "schema": "apss.workspace-operation/v1",
          "execution_id": "exec-42",
          "operation_key": "exec-42:phase-1:fence-9:agent",
          "argv": [
            "agent",
            "--print",
            "--output-format",
            "stream-json"
          ],
          "working_directory": "repo",
          "environment": {
            "LANG": "C.UTF-8"
          },
          "credential_bindings": [
            {
              "ref": {
                "name": "github-app",
                "scope": "repo:acme/widgets"
              },
              "delivery": "env",
              "target": "GH_TOKEN"
            }
          ],
          "launch_marker": {
            "argv0": "agent-launch",
            "line": "APSS-LAUNCH 6f1e9c"
          },
          "timeout_seconds": 3600,
          "metadata": {
            "phase_id": "phase-1"
          }
        }
      },
      "expect": {
        "schema": "workspace-operation.schema.json#/$defs/operationRef",
        "document": {
          "workspace": {
            "provider": "docker",
            "resource_id": "ws-7f3a"
          },
          "operation_id": "op-0001",
          "operation_key": "exec-42:phase-1:fence-9:agent"
        }
      },
      "launches": 1
    },
    {
      "call": "start",
      "args": {
        "spec": {
          "schema": "apss.workspace-operation/v1",
          "execution_id": "exec-42",
          "operation_key": "exec-42:phase-1:fence-9:agent",
          "argv": [
            "agent",
            "--different"
          ],
          "working_directory": "repo",
          "environment": {
            "LANG": "C.UTF-8"
          },
          "credential_bindings": [
            {
              "ref": {
                "name": "github-app",
                "scope": "repo:acme/widgets"
              },
              "delivery": "env",
              "target": "GH_TOKEN"
            }
          ],
          "launch_marker": {
            "argv0": "agent-launch",
            "line": "APSS-LAUNCH 6f1e9c"
          },
          "timeout_seconds": 3600,
          "metadata": {
            "phase_id": "phase-1"
          }
        }
      },
      "expect": {
        "schema": "workspace-status.schema.json",
        "document": {
          "schema": "apss.workspace-status/v1",
          "kind": "conflict",
          "message": "operation_key already started with a different spec"
        }
      },
      "launches": 1
    }
  ]
}
