diff --git a/lib/python/agentic_isolation/agentic_isolation/providers/docker_capabilities.py b/lib/python/agentic_isolation/agentic_isolation/providers/docker_capabilities.py
index 1c7175f..9247bd0 100644
--- a/lib/python/agentic_isolation/agentic_isolation/providers/docker_capabilities.py
+++ b/lib/python/agentic_isolation/agentic_isolation/providers/docker_capabilities.py
@@ -34,7 +34,7 @@ PROVIDER_LABEL = "agentic.provider"
 # goes to "$0" so a stop reaches it, and its exit status to "$0.rc", so
 # completion is read from the sandbox, never inferred from the docker client.
 _SUPERVISE = (
-    'shift; "$@" 2>&1 & child=$!; echo "$child" > "$0"; '
+    'shift; "$@" 2>/dev/null & child=$!; echo "$child" > "$0"; '
     'wait "$child"; rc=$?; echo "$rc" > "$0.rc"; exit "$rc"'
 )
 
